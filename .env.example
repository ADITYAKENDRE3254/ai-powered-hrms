# Database Configuration (PostgreSQL / SQLite)
# For PostgreSQL (Production): postgresql://user:password@host:5432/ai_hrms_db
# For SQLite (Development): sqlite:///./hrms.db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_hrms_db

# JWT Authentication
JWT_SECRET_KEY=super_secret_jwt_key_ai_hrms_2026_production_grade_token_signature_99182
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
# Optional: Set your OpenAI/Gemini/Anthropic API key if not using demo mode
AI_API_KEY=
AI_DEMO_MODE=true

# GPS Geofence Configuration (Default Office: Bangalore Tech Park)
OFFICE_NAME=Bangalore Innovation Hub
OFFICE_LATITUDE=12.9715987
OFFICE_LONGITUDE=77.5945627
GEOFENCE_RADIUS=100

# File Upload Paths
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
