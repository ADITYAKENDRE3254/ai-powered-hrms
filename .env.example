# ============================================================
# AI-HRMS ENVIRONMENT CONFIGURATION
# ============================================================

# Database Configuration (PostgreSQL / SQLite)
# For PostgreSQL (Production): postgresql://user:password@host:5432/ai_hrms_db
# For SQLite (Development): sqlite:///./hrms.db
DATABASE_URL=sqlite:///./hrms.db

# JWT Authentication
JWT_SECRET_KEY=change_this_to_a_secure_random_secret_in_production_32_chars_min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Configuration
# Optional: Set your Gemini / AI API key if not using built-in heuristic demo mode
AI_API_KEY=
AI_DEMO_MODE=true

# GPS Geofence Configuration (Default Office: Bangalore Tech Park)
OFFICE_NAME=Bangalore Innovation Hub
OFFICE_LATITUDE=12.9715987
OFFICE_LONGITUDE=77.5945627
GEOFENCE_RADIUS=100

# File Upload Paths
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# SMTP / Candidate Status Notifications
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
EMAILS_FROM_EMAIL=recruitment@ai-hrms.com
EMAILS_FROM_NAME=AI-HRMS Talent Acquisition

# Server & CORS Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:5173
