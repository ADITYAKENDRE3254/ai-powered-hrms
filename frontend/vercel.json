{
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://backend-red-ten-93.vercel.app/api/:path*"
    },
    {
      "source": "/docs",
      "destination": "https://backend-red-ten-93.vercel.app/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "https://backend-red-ten-93.vercel.app/api/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
